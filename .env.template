# ────────────────────────────────────────────────────────────────────────────
#  CONFIGURACIÓN GENERAL
# ────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución (development, production, etc.)
# Por defecto: production
NODE_ENV=production

# ────────────────────────────────────────────────────────────────────────────
#  CONFIGURACIÓN DEL BOT DE DISCORD
# ────────────────────────────────────────────────────────────────────────────

# Token del bot (obtenido desde Discord Developer Portal)
# OBLIGATORIO
BOT_TOKEN=

# ID de la aplicación del bot
# OBLIGATORIO
CLIENT_ID=

# ────────────────────────────────────────────────────────────────────────────
#  CONFIGURACIÓN DE COMANDOS DE TEXTO
# ────────────────────────────────────────────────────────────────────────────

# Habilitar comandos de texto (con prefijo !comando)
# Valores: 'true' = habilitar | cualquier otro valor o vacío = deshabilitar
# Si está habilitado (true), solo funcionarán los slash commands (/)
# IMPORTANTE: Requiere los intents GuildMessages y MessageContent habilitados
#             en el Discord Developer Portal > Bot > Privileged Gateway Intents
# Por defecto: false (deshabilitado)
USE_MESSAGE_CONTENT=true

# ────────────────────────────────────────────────────────────────────────────
#  PREFIJO DE COMANDOS DE TEXTO
# ────────────────────────────────────────────────────────────────────────────

# Prefijo para los comandos de texto
# Por defecto: !
COMMAND_PREFIX=!

# ────────────────────────────────────────────────────────────────────────────
#  INTENTS (AVANZADO - OPCIONAL)
# ────────────────────────────────────────────────────────────────────────────

# Intents personalizados (número calculado de intents)
# Si no se especifica, se usarán los intents automáticos según USE_MESSAGE_CONTENT
# Ejemplo: INTENTS=3276799
# Dejar vacío para usar configuración automática (recomendado)
INTENTS=

# ────────────────────────────────────────────────────────────────────────────
#  NIVEL DE LOGGING
# ────────────────────────────────────────────────────────────────────────────

# Nivel de logging para la aplicación
# Valores comunes: DEBUG, INFO, WARN, ERROR, FATAL, SILENT
# Por defecto: DEBUG cuando NODE_ENV=development, INFO cuando NODE_ENV=production
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────────────────
#  SHARDING (solo necesario a partir de los 2.500 servidores)
# ────────────────────────────────────────────────────────────────────────────

# Activa el modo sharding. Cuando está en true, usa el entry point de sharding:
#   Producción:  npm run start:sharding
#   Desarrollo:  npm run dev:sharding
# IMPORTANTE: Si se activa, REDIS_URL es obligatorio.
# Por defecto: false
SHARDING_ENABLED=false

# URL de conexión a Redis. Obligatorio cuando SHARDING_ENABLED=true.
# Formatos aceptados:
#   redis://host:port              → sin autenticación
#   redis://:password@host:port    → solo contraseña
#   redis://user:password@host:port → usuario y contraseña
#   rediss://...                   → conexión TLS/SSL
# Dejar vacío si SHARDING_ENABLED=false
REDIS_URL=

# Número de shards a lanzar. Discord recomienda 1 shard por cada 2.500 servidores.
# Valores: número entero positivo (ej. 4) | 'auto' (Discord calcula el valor óptimo)
# Por defecto: auto
TOTAL_SHARDS=auto