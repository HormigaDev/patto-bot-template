{
    "compilerOptions": {
        "types": ["node", "jest"],
        "target": "ES2021",
        "module": "CommonJS",
        "lib": ["ES2021"],
        "sourceMap": true,
        "outDir": "./dist",
        "paths": {
            "@/*": ["./src/*"],
            "@tests/*": ["./tests/*"]
        },
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*", "tests/**/*", "jest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
